# Auth.js – Secret erzeugen mit: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Wer sich anmelden darf: provider:accountId, kommagetrennt
# GitHub-ID: https://api.github.com/users/<name> -> "id"
# Discord-ID: Entwicklermodus -> Rechtsklick auf Profil -> ID kopieren
ALLOWED_USERS=github:00000000,discord:000000000000000000

# Pelican Client-API-Key (Konto -> API-Schlüssel)
PELICAN_URL=https://panel.example.de
PELICAN_API_KEY=

# Für private Repos: Fine-grained Token mit "Contents: Read"
GITHUB_TOKEN=

# 0 deaktiviert den automatischen Update-Check
UPDATE_INTERVAL_MINUTES=30

# MySQL oder MariaDB, Tabellen werden beim Start automatisch angelegt
DATABASE_URL=mysql://pluginsync:passwort@127.0.0.1:3306/pluginsync
